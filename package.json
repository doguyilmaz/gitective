{
  "name": "gitective",
  "displayName": "Gitective",
  "description": "Git blame, investigated: inline current-line blame, a calm hover card, a grouped commit menu, real diffs you can walk through, line history.",
  "version": "1.0.0",
  "publisher": "doguyilmaz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/doguyilmaz/gitective.git"
  },
  "bugs": {
    "url": "https://github.com/doguyilmaz/gitective/issues"
  },
  "homepage": "https://github.com/doguyilmaz/gitective#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1a1626",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "blame",
    "git blame",
    "annotate",
    "annotations",
    "authorship",
    "commit",
    "history",
    "line history",
    "diff",
    "compare",
    "gitlens"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Gitective runs git in your workspace, which requires trust."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Gitective needs a local git repository."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitective.toggleInline",
        "title": "Toggle Inline Blame",
        "category": "Gitective"
      },
      {
        "command": "gitective.commitMenu",
        "title": "Commit Menu for Current Line",
        "category": "Gitective"
      },
      {
        "command": "gitective.inspectCommit",
        "title": "Inspect Commit",
        "category": "Gitective"
      },
      {
        "command": "gitective.compareWithPrevious",
        "title": "Changes with Previous Revision",
        "category": "Gitective"
      },
      {
        "command": "gitective.compareWithWorking",
        "title": "Changes with Working Tree",
        "category": "Gitective"
      },
      {
        "command": "gitective.openAtRevision",
        "title": "Open File at Revision",
        "category": "Gitective"
      },
      {
        "command": "gitective.fileHistory",
        "title": "File History",
        "category": "Gitective"
      },
      {
        "command": "gitective.lineHistory",
        "title": "Line History",
        "category": "Gitective"
      },
      {
        "command": "gitective.searchCommits",
        "title": "Search Commits",
        "category": "Gitective"
      },
      {
        "command": "gitective.openOnRemote",
        "title": "Open Commit on Remote",
        "category": "Gitective"
      },
      {
        "command": "gitective.copyRemoteLink",
        "title": "Copy Commit Link",
        "category": "Gitective"
      },
      {
        "command": "gitective.copySha",
        "title": "Copy Commit SHA",
        "category": "Gitective"
      },
      {
        "command": "gitective.copyMessage",
        "title": "Copy Commit Message",
        "category": "Gitective"
      },
      {
        "command": "gitective.olderRevision",
        "title": "Older Revision",
        "category": "Gitective",
        "icon": "$(arrow-left)"
      },
      {
        "command": "gitective.newerRevision",
        "title": "Newer Revision",
        "category": "Gitective",
        "icon": "$(arrow-right)"
      },
      {
        "command": "gitective.openChangeInCommit",
        "title": "Open Change in Commit",
        "category": "Gitective"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "gitective.olderRevision",
          "when": "resourceScheme == gitective",
          "group": "navigation@1"
        },
        {
          "command": "gitective.newerRevision",
          "when": "resourceScheme == gitective",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "gitective.olderRevision",
          "when": "resourceScheme == gitective"
        },
        {
          "command": "gitective.newerRevision",
          "when": "resourceScheme == gitective"
        },
        {
          "command": "gitective.openChangeInCommit",
          "when": "false"
        },
        {
          "command": "gitective.commitMenu",
          "when": "editorIsOpen"
        },
        {
          "command": "gitective.inspectCommit",
          "when": "editorIsOpen"
        },
        {
          "command": "gitective.compareWithPrevious",
          "when": "editorIsOpen"
        },
        {
          "command": "gitective.compareWithWorking",
          "when": "editorIsOpen"
        },
        {
          "command": "gitective.openAtRevision",
          "when": "editorIsOpen"
        },
        {
          "command": "gitective.fileHistory",
          "when": "editorIsOpen"
        },
        {
          "command": "gitective.lineHistory",
          "when": "editorIsOpen"
        },
        {
          "command": "gitective.openOnRemote",
          "when": "editorIsOpen"
        },
        {
          "command": "gitective.copyRemoteLink",
          "when": "editorIsOpen"
        },
        {
          "command": "gitective.copySha",
          "when": "editorIsOpen"
        },
        {
          "command": "gitective.copyMessage",
          "when": "editorIsOpen"
        }
      ]
    },
    "configuration": {
      "title": "Gitective",
      "properties": {
        "gitective.inline.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show blame for the current line at the end of the line. Replaces VS Code's built-in `git.blame.editorDecoration.enabled`; Gitective offers once to turn the built-in one off."
        },
        "gitective.inline.format": {
          "type": "string",
          "default": "${author}, ${ago} • ${message}",
          "markdownDescription": "Inline blame template. Tokens: `${author}`, `${authorEmail}`, `${ago}`, `${agoOrDate}`, `${date}`, `${message}`, `${sha}`."
        },
        "gitective.inline.ageTint": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Tint the inline annotation by commit age (five buckets: under a day, a week, a month, a year, older). Colors: `gitective.inlineBlame.age1` … `age5`."
        },
        "gitective.hover.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the blame hover card (author, message, stat, actions). Richer than the built-in `git.blame` hover."
        },
        "gitective.hover.trigger": {
          "type": "string",
          "enum": [
            "annotation",
            "line"
          ],
          "default": "annotation",
          "markdownDescription": "`annotation`: show the card only when hovering the inline blame on the current line (falls back to the whole current line while inline blame is off). `line`: hover any line, anywhere."
        },
        "gitective.hover.avatars": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show author avatars in the hover card: GitHub (via the repo's `origin`, reusing an existing VS Code GitHub session, never prompting) then Gravatar, cached locally for a week; the last cached avatar is shown offline, initials when nothing is cached. Turn off to keep Gitective fully local."
        },
        "gitective.hover.showChanges": {
          "type": "boolean",
          "default": true,
          "description": "Show the blamed line's own diff line (just that line, not the hunk) above the Changes footer in the hover card."
        },
        "gitective.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show blame for the current line in the status bar (click opens the commit menu). Replaces VS Code's built-in `git.blame.statusBarItem.enabled`."
        },
        "gitective.statusBar.format": {
          "type": "string",
          "default": "$(git-commit) ${author}, ${ago}",
          "markdownDescription": "Status bar blame template. Tokens: `${author}`, `${authorEmail}`, `${ago}`, `${agoOrDate}`, `${date}`, `${message}`, `${sha}`. Codicons like `$(git-commit)` are allowed here."
        },
        "gitective.dateFormat": {
          "type": "string",
          "enum": [
            "short",
            "medium",
            "long",
            "full"
          ],
          "default": "medium",
          "markdownDescription": "Absolute date style used by `${date}`, `${agoOrDate}`, and the hover card."
        },
        "gitective.message.maxLength": {
          "type": "number",
          "default": 60,
          "minimum": 4,
          "description": "Truncate commit messages to this many characters in inline blame and the status bar."
        },
        "gitective.blame.ignoreWhitespace": {
          "type": "boolean",
          "default": false,
          "description": "Ignore whitespace-only changes when blaming (git blame -w), so reformatting commits do not claim lines."
        },
        "gitective.blame.ignoreRevsFile": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Honor a `.git-blame-ignore-revs` file at the repository root (git blame --ignore-revs-file)."
        }
      }
    },
    "colors": [
      {
        "id": "gitective.inlineBlame.foreground",
        "description": "Color of the inline blame annotation.",
        "defaults": {
          "dark": "#7d8590aa",
          "light": "#73777daa",
          "highContrast": "#99999999",
          "highContrastLight": "#666666"
        }
      },
      {
        "id": "gitective.inlineBlame.age1",
        "description": "Inline blame color for commits under a day (age tint).",
        "defaults": {
          "dark": "#ffb454",
          "light": "#a8641a",
          "highContrast": "#ffd18a",
          "highContrastLight": "#7a4400"
        }
      },
      {
        "id": "gitective.inlineBlame.age2",
        "description": "Inline blame color for commits under a week (age tint).",
        "defaults": {
          "dark": "#d9a65c",
          "light": "#9a6a2a",
          "highContrast": "#e6c48f",
          "highContrastLight": "#6b4a10"
        }
      },
      {
        "id": "gitective.inlineBlame.age3",
        "description": "Inline blame color for commits under a month (age tint).",
        "defaults": {
          "dark": "#a58e63",
          "light": "#8a7455",
          "highContrast": "#cfc0a6",
          "highContrastLight": "#5a4a30"
        }
      },
      {
        "id": "gitective.inlineBlame.age4",
        "description": "Inline blame color for commits under a year (age tint).",
        "defaults": {
          "dark": "#8b8b8b",
          "light": "#7a7a7a",
          "highContrast": "#b0b0b0",
          "highContrastLight": "#4a4a4a"
        }
      },
      {
        "id": "gitective.inlineBlame.age5",
        "description": "Inline blame color for commits older (age tint).",
        "defaults": {
          "dark": "#666a70",
          "light": "#8f8f95",
          "highContrast": "#8f8f95",
          "highContrastLight": "#5a5a60"
        }
      }
    ],
    "keybindings": [
      {
        "command": "gitective.commitMenu",
        "key": "alt+shift+b",
        "when": "editorTextFocus"
      },
      {
        "command": "gitective.lineHistory",
        "key": "alt+shift+h",
        "when": "editorTextFocus"
      },
      {
        "command": "gitective.olderRevision",
        "key": "alt+shift+,",
        "when": "resourceScheme == gitective"
      },
      {
        "command": "gitective.newerRevision",
        "key": "alt+shift+.",
        "when": "resourceScheme == gitective"
      }
    ],
    "walkthroughs": [
      {
        "id": "gitective.gettingStarted",
        "title": "Get started with Gitective",
        "description": "Blame that stays out of your way: three things to try.",
        "steps": [
          {
            "id": "hover",
            "title": "Hover the inline blame",
            "description": "Put the cursor on any line of a file in a git repository. The annotation at the end of the line is the blame; hover it for the card.\n[Open a file](command:workbench.action.quickOpen)",
            "media": {
              "markdown": "media/walkthrough/hover.md"
            }
          },
          {
            "id": "menu",
            "title": "Open the commit menu",
            "description": "Press ``alt+shift+b`` (or click the status bar blame) for everything about the commit: changes, files, remote link, copy, safe git actions.\n[Open the commit menu](command:gitective.commitMenu)",
            "media": {
              "markdown": "media/walkthrough/menu.md"
            }
          },
          {
            "id": "history",
            "title": "Walk history",
            "description": "From any diff, use ← → in the title (``alt+shift+,`` / ``alt+shift+.``) to step through revisions, or ``alt+shift+h`` for the history of one line.\n[Line history](command:gitective.lineHistory)",
            "media": {
              "markdown": "media/walkthrough/history.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "bun esbuild.mjs",
    "watch": "bun esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src test",
    "test": "bun test",
    "test:vsc": "bun run build && vscode-test",
    "vscode:prepublish": "bun esbuild.mjs --production",
    "package": "vsce package",
    "icon": "swift scripts/icon.swift"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "trustedDependencies": [
    "@vscode/vsce-sign"
  ],
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3"
  }
}
